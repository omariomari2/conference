    <script>
        (() => {
            const initMobileNav = () => {
                const toggle = document.querySelector("[data-mobile-nav-toggle]");
                const panel = document.querySelector("[data-mobile-nav-panel]");
                if (!toggle || !panel) return;

                const openClass = "is-open";
                const hasGsap = typeof window.gsap !== "undefined";
                let scrollLockY = 0;
                panel.style.willChange = "transform, opacity";

                const lockScroll = () => {
                    scrollLockY = window.scrollY || window.pageYOffset || 0;
                    document.body.classList.add("mobile-nav-open");
                    document.body.style.position = "fixed";
                    document.body.style.top = `-${scrollLockY}px`;
                    document.body.style.width = "100%";
                };

                const restoreScrollPosition = (targetY) => {
                    const html = document.documentElement;
                    const previousBehavior = html.style.scrollBehavior;
                    html.style.scrollBehavior = "auto";
                    window.scrollTo(0, targetY);
                    html.style.scrollBehavior = previousBehavior;
                };

                const unlockScroll = (scrollToId) => {
                    document.body.classList.remove("mobile-nav-open");
                    document.body.style.position = "";
                    document.body.style.top = "";
                    document.body.style.width = "";
                    if (scrollToId) {
                        const el = document.getElementById(scrollToId);
                        if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
                        else restoreScrollPosition(scrollLockY);
                    } else {
                        restoreScrollPosition(scrollLockY);
                    }
                };

                const setOpen = (open) => {
                    toggle.setAttribute("aria-expanded", open ? "true" : "false");
                    panel.setAttribute("aria-hidden", open ? "false" : "true");
                    panel.classList.toggle(openClass, open);
                };

                const openPanel = () => {
                    if (panel.classList.contains(openClass)) return;
                    setOpen(true);
                    lockScroll();
                    if (!hasGsap) return;
                    window.gsap.killTweensOf(panel);
                    window.gsap.fromTo(
                        panel,
                        { opacity: 0, y: 28 },
                        {
                            opacity: 1,
                            y: 0,
                            duration: 0.6,
                            ease: "power3.out"
                        }
                    );
                    const links = panel.querySelectorAll("a, button");
                    if (links.length) {
                        window.gsap.killTweensOf(links);
                        window.gsap.fromTo(
                            links,
                            { opacity: 0, y: 10 },
                            {
                                opacity: 1,
                                y: 0,
                                duration: 0.45,
                                ease: "power3.out",
                                stagger: 0.04,
                                delay: 0.06
                            }
                        );
                    }
                };

                const closePanel = (scrollToId) => {
                    if (!panel.classList.contains(openClass)) return;
                    toggle.setAttribute("aria-expanded", "false");
                    if (!hasGsap) {
                        setOpen(false);
                        unlockScroll(scrollToId);
                        return;
                    }
                    window.gsap.killTweensOf(panel);
                    window.gsap.to(panel, {
                        opacity: 0,
                        y: 20,
                        duration: 0.3,
                        ease: "power2.in",
                        onComplete: () => {
                            panel.setAttribute("aria-hidden", "true");
                            panel.classList.remove(openClass);
                            unlockScroll(scrollToId);
                        }
                    });
                };

                setOpen(false);
                toggle.addEventListener("click", (event) => {
                    event.preventDefault();
                    if (panel.classList.contains(openClass)) {
                        closePanel();
                    } else {
                        openPanel();
                    }
                });

                const closeButton = document.querySelector("[data-mobile-nav-close]");
                if (closeButton) {
                    closeButton.addEventListener("click", (event) => {
                        event.preventDefault();
                        closePanel();
                    });
                }

                panel.addEventListener("click", (event) => {
                    const link = event.target.closest("a");
                    if (link) {
                        const href = link.getAttribute("href") || "";
                        const scrollToId = href.startsWith("#") ? href.slice(1) : null;
                        if (scrollToId) event.preventDefault();
                        closePanel(scrollToId);
                    }
                });
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initMobileNav);
            } else {
                initMobileNav();
            }
        })();
    </script>
    
